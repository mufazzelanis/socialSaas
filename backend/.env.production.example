# Copy this to .env on the production server and fill in the blanks.
# Never commit the real .env — this file is just a template.

APP_NAME="Social SaaS"
APP_ENV=production
# CRITICAL: must be false in production. When true, error responses
# include full stack traces (file paths, code) — a real information leak.
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# "error" in production — "debug" is noisy and can leak sensitive request data into logs.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_saas
DB_USERNAME=social_saas_app
# Use a real generated password here, not the local dev "no password" setup.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Only needed once you actually add Redis/queue workers (a later phase).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Fill in real SMTP details before relying on password reset / notification
# emails — MAIL_MAILER=log (the local dev default) just writes emails to a
# log file instead of sending them.
# Gmail SMTP works fine at low volume (personal Gmail: ~500 emails/day cap;
# Google Workspace: ~2000/day) — host smtp.gmail.com, port 587, username is
# the full Gmail address, password is a 16-char Google *App Password*
# (Google Account -> Security -> 2-Step Verification -> App Passwords;
# requires 2FA enabled). Move to a transactional provider (SES/Postmark/
# Mailgun) if volume grows past that.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Only needed if you switch FILESYSTEM_DISK to s3 for uploaded media (advised
# once you run more than one app server, so uploads aren't stuck on one disk).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: the exact origin(s) your frontend is served from. Comma-separated,
# no trailing slash, must include the scheme (https://).
FRONTEND_URLS=https://app.yourdomain.com

# The single canonical frontend origin — used to build links inside emails
# (password reset, admin-created account welcome mail). Usually the first
# entry in FRONTEND_URLS above.
FRONTEND_URL=https://app.yourdomain.com

# Set to false once you're ready to gate new signups behind admin-granted
# platform permissions instead of opening everything by default.
GRANT_ALL_PLATFORMS_ON_REGISTRATION=true
